rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'currency', 'monthlyGoal', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.email is string && data.email.size() <= 150
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('monthlyGoal' in data) || (data.monthlyGoal is number && data.monthlyGoal >= 0))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidEarning(data, userId) {
      return data.keys().hasAll(['userId', 'date', 'grossAmount', 'deductions', 'netAmount', 'category', 'paymentStatus'])
        && data.keys().hasOnly(['userId', 'date', 'grossAmount', 'deductions', 'netAmount', 'category', 'clientName', 'paymentMethod', 'paymentStatus', 'referenceId', 'notes', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.date is string && data.date.size() >= 10 && data.date.size() <= 25
        && data.grossAmount is number && data.grossAmount > 0
        && data.deductions is number && data.deductions >= 0
        && data.netAmount is number
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && (data.paymentStatus == 'Received' || data.paymentStatus == 'Pending' || data.paymentStatus == 'Partially Paid')
        && (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 150))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
        && (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId)
                    && incoming().userId == existing().userId;
      allow delete: if false;

      match /earnings/{earningId} {
        allow get: if isOwner(userId) && isValidId(earningId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(earningId) && isValidEarning(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(earningId) && isValidEarning(incoming(), userId)
                      && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(earningId);
      }
    }
  }
}
